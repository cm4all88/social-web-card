# Yooits PREVIEW: a private test copy of the site.
# Non-secret settings only. Secrets live in the "preview" environment on
# GitHub (or deploy/environments/preview.secrets.local for local runs).
PROJECT_NAME=yooits-preview
BUILD_MODE=preview
# Ask for a site password before showing any page, but only while SITE_PASSWORD
# is set (if-set). Remove SITE_PASSWORD from Vercel to open the site.
PASSWORD_PROTECT=if-set
# Load the example.com test accounts and content only when the Vercel project
# (or the secrets file) sets SEED_TEST_ACCOUNTS=true.
SEED_TEST_DATA=no
# Back up the database before applying migrations.
BACKUP_BEFORE_MIGRATE=no
# Stripe live keys are refused while this is "no".
ALLOW_STRIPE_LIVE=no
# Leave empty to use the <project>.vercel.app address.
CUSTOM_DOMAIN=
