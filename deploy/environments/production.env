# Yooits PRODUCTION once it's hosted independently of Lovable.
# NOT IN USE YET: the live site is still built and hosted by Lovable, and
# deploy.sh refuses Lovable's database in every environment.
# Before first use: a new Supabase project for production, a "production"
# environment on GitHub with its own secrets and a required reviewer, and
# Chris's approval. See deploy/MIGRATION.md.
PROJECT_NAME=yooits
BUILD_MODE=production
PASSWORD_PROTECT=no
SEED_TEST_DATA=no
BACKUP_BEFORE_MIGRATE=yes
# Stays "no" until live payments are approved.
ALLOW_STRIPE_LIVE=no
# e.g. yooits.me, once DNS moves (not before the migration).
CUSTOM_DOMAIN=
